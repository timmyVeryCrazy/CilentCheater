local outlineWhite       = false

local function getOutlineColor()
    return outlineWhite and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
end

local function updateESPForPlayer(player)
    if not player.Character then
        if playerHighlights[player] then
            playerHighlights[player]:Destroy()
            playerHighlights[player] = nil
        end
        return
    end
    local role = getPlayerRole(player)
    local shouldShow =
        (role == "Murderer" and murdererESPEnabled) or
        (role == "Sheriff"  and sheriffESPEnabled)  or
        (role == "Innocent" and innocentESPEnabled)

    if shouldShow then
        local color = RoleColors[role]
        if not playerHighlights[player] then
            local h = Instance.new("Highlight")
            h.Name                = "ESPHighlight"
            h.FillTransparency    = 0.5
            h.OutlineTransparency = 0
            h.OutlineColor        = getOutlineColor()
            h.FillColor           = color
            h.Adornee             = player.Character
            h.Parent              = player.Character
            playerHighlights[player] = h
        else
            playerHighlights[player].FillColor    = color
            playerHighlights[player].OutlineColor = getOutlineColor()
            if playerHighlights[player].Adornee ~= player.Character then
                playerHighlights[player].Adornee = player.Character
            end
        end
    else
        if playerHighlights[player] then
            playerHighlights[player]:Destroy()
            playerHighlights[player] = nil
        end
    end

    -- Name labels
    if namesESPEnabled and player.Character and player.Character:FindFirstChild("Head") then
        if not nameLabels[player] then
            local bb = Instance.new("BillboardGui")
            bb.Name          = "ESPName"
            bb.Size          = UDim2.new(0, 100, 0, 30)
            bb.StudsOffset   = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop   = true
            bb.Adornee       = player.Character.Head
            bb.Parent        = player.Character.Head
            local lbl        = Instance.new("TextLabel")
            lbl.Size         = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3   = RoleColors[getPlayerRole(player)] or Color3.new(1,1,1)
            lbl.TextStrokeTransparency = 0
            lbl.Font         = Enum.Font.GothamBold
            lbl.TextSize     = 14
            lbl.Text         = player.Name
            lbl.Parent       = bb
            nameLabels[player] = bb
        end
    else
        if nameLabels[player] then
            nameLabels[player]:Destroy()
            nameLabels[player] = nil
        end
    end
end

local function clearAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if playerHighlights[p] then playerHighlights[p]:Destroy() playerHighlights[p] = nil end
        if nameLabels[p]       then nameLabels[p]:Destroy()       nameLabels[p] = nil       end
    end
end

local function spawnESPLoop(getEnabled)
    task.spawn(function()
        while getEnabled() do
            pcall(function()
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then updateESPForPlayer(p) end
                end
            end)
            task.wait(1)
        end
        clearAllESP()
    end)
end

