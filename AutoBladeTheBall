local fontLoaded     = false
local activeFont     = nil
local activeFontSize = nil

local function loadFonts()
    if fontLoaded then return true end
    local ok = pcall(function()
        local hs    = HttpService
        local fonts = {
            { file = "minecrafter.ttf", name = "Minecrafter", id = "1_LSZQUGrKHzJctxK7Jp8rVRRVWIvdif4" },
            { file = "horror.ttf",      name = "Horror",      id = "1dH4Y_ZuoTeMouMQoGZSc1OVLT7-73zmq" },
            { file = "vhsgothic.ttf",   name = "VHS",         id = "1XRWSIsNj9-v-vnrOCdYiUJIvz6ETAzfE" },
            { file = "starborn.ttf",    name = "Starborn",    id = "1k9H8G60p7iaJL4hHcyWEXgWJbONqam8_" },
        }
        for _, f in ipairs(fonts) do
            local data = game:HttpGet("https://drive.google.com/uc?export=download&id=" .. f.id)
            writefile(f.file, data)
            local json = hs:JSONEncode({
                name  = f.name,
                faces = {{ style = "normal", assetId = getcustomasset(f.file), name = "Regular", weight = 400 }}
            })
            writefile(f.name .. ".json", json)
        end
    end)
    fontLoaded = true
    return ok
end

local function applyFont(jsonName)
    pcall(function()
        local font = Font.new(getcustomasset(jsonName .. ".json"))
        local pg   = LP:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, obj in ipairs(pg:GetDescendants()) do
            pcall(function()
                if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and obj.Text ~= "" then
                    obj.FontFace = font
                    if activeFontSize then
                        obj.TextScaled = false
                        obj.TextSize   = activeFontSize
                    end
                end
            end)
        end
    end)
end

local function resetFont()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, obj in ipairs(pg:GetDescendants()) do
        pcall(function()
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                obj.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json")
            end
        end)
    end
    activeFont = nil
end

_S29:Button({
    Title    = "Download All Fonts",
    Desc     = "Download fonts first before applying",
    Callback = function() task.spawn(loadFonts) end,
})

_S29:Slider({
    Title    = "Font Size",
