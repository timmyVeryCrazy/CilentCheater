    Value    = { Min = 0, Max = 36, Default = 0 },
    Step     = 1,
    Callback = function(v)
        activeFontSize = (v == 0) and nil or v
        if activeFont then
            task.spawn(function() loadFonts() applyFont(activeFont) end)
        end
    end,
})

local fontToggles = {}
local fontNames   = { "Starborn", "Minecrafter", "Horror", "VHS" }

for _, name in ipairs(fontNames) do
    local n = name
    local toggle
    toggle = _S29:Toggle({
        Title    = "Font: " .. n,
        Desc     = "Toggle " .. n .. " on/off",
        Value    = false,
        Callback = function(v)
            if v then
                for fname, setFn in pairs(fontToggles) do
                    if fname ~= n then setFn(false) end
                end
                activeFont = n
                task.spawn(function() loadFonts() applyFont(n) end)
            else
                if activeFont == n then
                    activeFont = nil
                    pcall(resetFont)
                end
            end
        end,
    })
    fontToggles[n] = function(val)
        pcall(function() toggle:Set(val) end)
    end
end

