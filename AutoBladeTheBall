-- ── Helpers ───────────────────────────────────────────────────────────────────
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP()
    return getChar():WaitForChild("HumanoidRootPart")
end
local function findPlayerWithTool(toolName)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local has =
                (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild(toolName)) or
                (p.Character and p.Character:FindFirstChild(toolName))
            if has then return p end
        end
    end
end

local function getPlayerRole(player)
    local function hasTool(name)
        if player:FindFirstChild("Backpack") then
            for _, t in ipairs(player.Backpack:GetChildren()) do
                if t:IsA("Tool") and t.Name == name then return true end
            end
        end
        if player.Character then
            for _, t in ipairs(player.Character:GetChildren()) do
                if t:IsA("Tool") and t.Name == name then return true end
            end
        end
        return false
    end
    if hasTool("Knife") then return "Murderer" end
    if hasTool("Gun")   then return "Sheriff"  end
    return "Innocent"
end

-- ── Shoot helper ──────────────────────────────────────────────────────────────
local function shootAtTarget(target)
    if not (target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")) then return end
    local gun = getChar():FindFirstChild("Gun")
    if not gun then
        WindUI:Notify({ Title = "Sheriff", Content = "Equip the Gun first!" })
        return
    end
    local myHRP            = getChar():FindFirstChild("HumanoidRootPart")
    local originAttachment = myHRP and myHRP:FindFirstChild("GunRaycastAttachment")
    local originCFrame     = originAttachment and originAttachment.WorldCFrame or nil
    local enemyHRP         = target.Character.HumanoidRootPart
    local velocity         = enemyHRP.Velocity
    local pingMs           = 0
    local stats            = game:GetService("Stats")
    if stats:FindFirstChild("Network") and stats.Network:FindFirstChild("ServerStatsItem") then
        local ps = stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
        if ps then pingMs = ps:GetValue() end
    end
    local pingSec    = math.clamp(pingMs / 1000, 0, 1)
    local leadOffset = velocity.Magnitude < 2 and Vector3.new() or velocity * pingSec
    local targetCFrame = CFrame.new(enemyHRP.Position + leadOffset)
    pcall(function()
        gun:WaitForChild("Shoot"):FireServer(originCFrame, targetCFrame)
    end)
end

